<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_my_events"
        android:shortcutDisabledMessage="@string/shortcut_pass_short"
        android:shortcutId="shortcut_my_pass"
        android:shortcutLongLabel="@string/shortcut_pass_long"
        android:shortcutShortLabel="@string/shortcut_pass_short">
        <intent
            android:action="com.kuet.clubhub.action.SHORTCUT_MY_PASS"
            android:targetClass="com.kuet.clubhub.ui.LauncherActivity"
            android:targetPackage="com.kuet.clubhub" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_events"
        android:shortcutDisabledMessage="@string/shortcut_scan_short"
        android:shortcutId="shortcut_scan_qr"
        android:shortcutLongLabel="@string/shortcut_scan_long"
        android:shortcutShortLabel="@string/shortcut_scan_short">
        <intent
            android:action="com.kuet.clubhub.action.SHORTCUT_SCAN_QR"
            android:targetClass="com.kuet.clubhub.ui.LauncherActivity"
            android:targetPackage="com.kuet.clubhub" />
    </shortcut>
</shortcuts>
